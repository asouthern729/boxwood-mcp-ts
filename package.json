{
  "name": "boxwood-mcp-ts",
  "version": "1.0.0",
  "description": "MCP server exposing customer/policy/invoice lookup tools over the boxwood-ams360 Postgres database",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -b",
    "start": "node dist/app.js",
    "deploy": "pm2 kill && pm2 reload ecosystem.config.cjs",
    "deploy:site": "rsync -a --delete site/ /var/www/site/"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "@aws-sdk/client-sesv2": "^3.1121.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.6",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "sequelize": "^6.37.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
