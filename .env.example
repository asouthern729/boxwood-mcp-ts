PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=boxwood_ams360
PORT=3000
LOG_LEVEL=info

AUTH0_TENANT_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_API_URI=

# Needed only by scripts/morningDownload.ts (the unattended download-review automation)
ANTHROPIC_API_KEY=

# AWS SES — needed only by src/utils/mailer.ts, for emailing the finished download report. Sent
# over the SES HTTPS API (not SMTP) since outbound SMTP ports are blocked on this host; same
# convention as the ams360-etl project's mailer. AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY must be
# a real IAM key/secret with ses:SendEmail permission — NOT SES's separate "SMTP credentials"
# (those are a derived password valid only for SMTP AUTH, not API calls). MAIL_FROM must be a
# verified SES sender identity.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_FROM=